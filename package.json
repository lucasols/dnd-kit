{
  "name": "dnd-kit-lucasols-fork",
  "description": "dnd kit – a lightweight React library for building performant and accessible drag and drop experiences",
  "author": "Claudéric Demers",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "pnpm -r --parallel run start",
    "test": "vitest run",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "pnpm -r run build",
    "build:storybook": "build-storybook",
    "start:storybook": "start-storybook -p 6006",
    "cypress": "cypress run",
    "cypress:open": "cypress open",
    "release": "pnpm -r publish --access public"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^0.4.0",
    "@changesets/cli": "^2.16.0",
    "@storybook/addon-essentials": "^6.5.5",
    "@storybook/addon-info": "^5.3.21",
    "@storybook/addon-links": "^6.5.5",
    "@storybook/addons": "^6.5.5",
    "@storybook/react": "^6.5.5",
    "@types/classnames": "^2.2.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-loader": "^8.2.1",
    "chromatic": "^5.4.0",
    "classnames": "^2.2.6",
    "css-loader": "^2.0.0",
    "cypress": "^9.5.2",
    "framer-motion": "^3.1.1",
    "oxlint": "^1.87.0",
    "postcss": "^8.1.10",
    "postcss-loader": "^4.1.0",
    "postcss-nested": "^5.0.1",
    "postcss-simple-vars": "^6.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-tiny-virtual-list": "^2.2.0",
    "style-loader": "^2.0.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.11.2"
}
