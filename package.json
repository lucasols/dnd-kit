{
  "name": "dnd-kit-lucasols-fork",
  "description": "dnd kit – a lightweight React library for building performant and accessible drag and drop experiences",
  "author": "Claudéric Demers",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "pnpm -r --parallel run start",
    "test": "vitest run",
    "lint": "oxlint && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p cypress/tsconfig.json",
    "build": "pnpm -r run build",
    "build:storybook": "storybook build",
    "start:storybook": "storybook dev -p 6006",
    "cypress": "cypress run",
    "cypress:open": "cypress open",
    "release": "pnpm -r publish --access public"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.2",
    "@tanstack/react-virtual": "^3.14.17",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "chromatic": "^18.12.0",
    "classnames": "^2.5.1",
    "cypress": "^16.1.1",
    "framer-motion": "^14.1.0",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.30",
    "postcss-nested": "^8.0.1",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "storybook": "^10.6.2",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@12.11.2"
}
