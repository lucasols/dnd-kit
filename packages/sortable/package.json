{
  "name": "@lucasols/dnd-kit-sortable",
  "version": "0.1.4",
  "description": "Official sortable preset and sensors for dnd kit",
  "author": "Claudéric Demers",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clauderic/dnd-kit.git",
    "directory": "packages/sortable"
  },
  "scripts": {
    "start": "tsdown --config ../../tsdown.config.mts --watch",
    "build": "tsdown --config ../../tsdown.config.mts",
    "test": "vitest run --config ../../vitest.config.mts",
    "prepublishOnly": "pnpm run build"
  },
  "type": "module",
  "main": "./dist/index.js",
